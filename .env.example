# Copy to `.env` for local overrides. Nuxt maps `NUXT_*` variables onto `runtimeConfig`
# (see `apps/web/nuxt.config.ts`); nothing here is required for `pnpm dev` or the tests.

# Data Provider behind the `/api/*` routes: `fixture` (generated town, no network) or
# `open-data` (OpenStreetMap Overpass, Nominatim, HM Land Registry Price Paid Data).
# Default: `open-data` when NODE_ENV=production, otherwise `fixture`.
NUXT_DATA_PROVIDER=fixture

# Identifying User-Agent on every upstream request. Nominatim's policy requires one that names
# the deployment and a way to contact its operator.
# Default: `what-does-a-house-cost-here/<apps/web version> (+https://github.com/timdamen/what-does-a-house-cost-here)`.
# NUXT_USER_AGENT="what-does-a-house-cost-here/0.0.0 (+https://github.com/timdamen/what-does-a-house-cost-here)"

# MapLibre style URLs for the light and dark themes (public: shipped to the browser).
# Defaults: the VersaTiles open host.
# NUXT_PUBLIC_MAP_STYLE_LIGHT=https://tiles.versatiles.org/assets/styles/colorful/style.json
# NUXT_PUBLIC_MAP_STYLE_DARK=https://tiles.versatiles.org/assets/styles/eclipse/style.json
